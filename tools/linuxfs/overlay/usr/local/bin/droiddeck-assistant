#!/usr/bin/env python3
"""Launch installed assistants without changing agent permissions or installing software."""
import argparse
import configparser
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


PROGRAMS = ('codex', 'codex-desktop', 'chatgpt', 'git', 'python3', 'node', 'npm',
            'bash', 'rg', 'curl', 'gio', 'dbus-run-session', 'xdg-open', 'fcitx5')


def desktop_apps():
    roots = [Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')]
    roots += [Path(p) for p in (os.environ.get('XDG_DATA_DIRS') or
                               '/usr/local/share:/usr/share').split(':') if p]
    entries, seen = [], set()
    for root in roots:
        if not root.is_absolute():
            continue
        directory = root / 'applications'
        for path in sorted(directory.glob('**/*.desktop')):
            desktop_id = str(path.relative_to(directory)).replace('/', '-')
            if desktop_id in seen:
                continue
            seen.add(desktop_id)
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read_string(path.read_text(encoding='utf-8'))
                entry = parser['Desktop Entry']
                if entry.get('Type') != 'Application' or entry.get('Hidden', '').lower() == 'true':
                    continue
                name, executable = entry.get('Name', ''), entry.get('Exec', '')
                identity = ' '.join((desktop_id, name, entry.get('Name[zh_CN]', '')))
                if not re.search(r'codex|chatgpt', identity, re.IGNORECASE):
                    continue
                if (entry.get('X-DroidDeck-Assistant', '').lower() == 'true' or
                        'droiddeck-assistant' in executable or not executable):
                    continue
                entries.append({'id': desktop_id, 'name': name, 'path': str(path),
                                'exec': executable, 'workingDirectory': entry.get('Path', ''),
                                'tryExec': entry.get('TryExec', ''),
                                'noDisplay': entry.get('NoDisplay', '').lower() == 'true'})
            except (OSError, UnicodeError, configparser.Error, KeyError):
                continue
    return entries


def workspace_path(value=None):
    path = Path(value).expanduser().resolve() if value else Path.cwd()
    if not path.is_dir() or not os.access(path, os.R_OK | os.X_OK):
        raise ValueError(f'工作目录不存在或不可访问: {path}')
    return path


def check_tools(programs, workspace):
    probes = {
        'bash': ['--noprofile', '--norc', '-c', 'printf droiddeck-ok'],
        'git': ['--version'],
        'python3': ['-I', '-c', 'print("droiddeck-ok")'],
        'node': ['-e', 'process.stdout.write("droiddeck-ok")'],
        'npm': ['--version'],
        'rg': ['--version'],
    }
    results = {}
    for name, arguments in probes.items():
        if not programs.get(name):
            results[name] = {'status': 'missing'}
            continue
        try:
            result = subprocess.run([programs[name]] + arguments, cwd=str(workspace),
                                    capture_output=True, text=True, errors='replace', timeout=5)
            results[name] = {'status': 'passed' if result.returncode == 0 else 'failed',
                             'exitCode': result.returncode,
                             'stdout': result.stdout[:2000], 'stderr': result.stderr[:2000]}
        except subprocess.TimeoutExpired:
            results[name] = {'status': 'timeout'}
        except OSError as error:
            results[name] = {'status': 'failed', 'error': str(error)}
    return results


def diagnose(workspace=None, run_checks=False):
    path = workspace_path(workspace)
    programs = {name: shutil.which(name) for name in PROGRAMS}
    result = {
        'architecture': os.uname().machine,
        'programs': programs,
        'desktopApps': desktop_apps(),
        'display': bool(os.environ.get('DISPLAY')),
        'wayland': bool(os.environ.get('WAYLAND_DISPLAY')),
        'dbus': bool(os.environ.get('DBUS_SESSION_BUS_ADDRESS')),
        'locale': os.environ.get('LANG', ''),
        'inputMethod': {name: os.environ.get(name, '') for name in
                        ('GTK_IM_MODULE', 'QT_IM_MODULE', 'XMODIFIERS')},
        'graphicsEnvironment': {name: os.environ.get(name, '') for name in (
            'LIBGL_ALWAYS_SOFTWARE', 'GALLIUM_DRIVER', 'QT_QUICK_BACKEND',
            'MESA_LOADER_DRIVER_OVERRIDE', 'MESA_VK_WSI_DEBUG', 'LIBGL_KOPPER_DRI2',
            'KWIN_COMPOSE', 'GDK_BACKEND', 'QT_QPA_PLATFORM', 'SDL_VIDEODRIVER',
            'VK_ICD_FILENAMES', 'VK_DRIVER_FILES', 'DRI_PRIME', 'mesa_glthread')},
        'workspace': str(path),
        'workspaceWritable': os.access(path, os.W_OK | os.X_OK),
        'toolExecution': 'not tested (executable discovery only)',
        'codexSandbox': 'not tested',
        'electronSandbox': 'application default; not tested',
        'limitations': [
            'A working window does not prove Codex shell, browser, MCP or sandbox support.',
            'PRoot shares the Android kernel; namespace and sandbox availability must be tested on the device.',
            'This launcher does not disable Codex approvals or its workspace sandbox.',
            'Desktop entries are installed application metadata, not proof of publisher or architecture compatibility.',
            'Environment variables and executable presence do not prove display, D-Bus or IME connectivity.',
            'Auto graphics inherits desktop renderer settings; removing --disable-gpu does not prove hardware acceleration.',
        ],
    }
    if run_checks:
        result['toolChecks'] = check_tools(programs, path)
        result['toolExecution'] = 'local smoke checks only; not inside the Codex sandbox'
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if run_checks and any(item['status'] != 'passed' for item in result['toolChecks'].values()):
        return 1
    return 0


def command(mode, arguments, executable=None, desktop_file=None, display='auto', graphics='auto'):
    if mode not in ('codex', 'codex-desktop', 'chatgpt'):
        raise ValueError('Use doctor, apps, codex, codex-desktop or chatgpt.')
    if display not in ('auto', 'x11', 'wayland') or graphics not in ('auto', 'software'):
        raise ValueError('Invalid display or graphics selection.')
    if executable and desktop_file:
        raise ValueError('--executable 和 --desktop-file 不能同时使用。')
    if mode == 'codex' and (desktop_file or display != 'auto' or graphics != 'auto'):
        raise ValueError('codex 是命令行模式，不接受桌面显示选项。')
    env = dict(os.environ)
    env.setdefault('LANG', 'zh_CN.UTF-8')
    message_locale = env.get('LC_ALL') or env.get('LC_MESSAGES') or env.get('LANG', '')
    if re.split(r'[.@]', message_locale, maxsplit=1)[0] == 'zh_CN':
        env.setdefault('LANGUAGE', 'zh_CN:zh')
    env.setdefault('TERM', 'xterm-256color')
    if desktop_file:
        matches = [item for item in desktop_apps() if desktop_file in (item['id'], item['path'])]
        if len(matches) != 1:
            raise ValueError('未找到唯一已安装桌面入口；运行 droiddeck-assistant apps 查看路径。')
        if arguments or display != 'auto' or graphics != 'auto':
            raise ValueError('桌面入口保留应用原有启动参数；自定义参数/图形选项请使用 --executable。')
        gio = shutil.which('gio')
        if not gio:
            raise ValueError('找不到 gio；请用 --executable 指定已安装程序。')
        # GIO owns desktop Exec quoting, field codes and Path semantics; never evaluate it as shell text.
        return [gio, 'launch', matches[0]['path']], env
    program = shutil.which(executable or mode)
    if not program:
        raise ValueError(f'{executable or mode} 未安装或不在 PATH 中。运行 droiddeck-assistant apps '
                         '查找已安装桌面入口，或用 --executable 指定可信的兼容 Linux 程序。')
    args = [os.path.abspath(program)]
    if mode != 'codex':
        if display == 'x11':
            if not env.get('DISPLAY'):
                raise ValueError('选择 X11 需要 DISPLAY；请先进入桌面会话。')
            args.append('--ozone-platform=x11')
            env.pop('WAYLAND_DISPLAY', None)
            env['XDG_SESSION_TYPE'] = 'x11'
        elif display == 'wayland':
            if not env.get('WAYLAND_DISPLAY'):
                raise ValueError('选择 Wayland 需要 WAYLAND_DISPLAY；请先进入桌面会话。')
            args.append('--ozone-platform=wayland')
            env['XDG_SESSION_TYPE'] = 'wayland'
        if graphics == 'software':
            args.append('--disable-gpu')
    return args + arguments, env


def main(arguments):
    parser = argparse.ArgumentParser(description='启动已安装的 Codex/ChatGPT；不下载客户端，不修改授权或沙箱。',
                                     epilog='启动器选项放在模式之前，模式之后的参数原样传给应用。')
    parser.add_argument('--check-tools', action='store_true', help='doctor: 运行本地工具基础检查，每项最多 5 秒')
    parser.add_argument('--workspace', metavar='DIR', help='工作目录；默认保留当前目录')
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument('--executable', metavar='PATH', help='已安装程序的路径或命令名')
    selection.add_argument('--desktop-file', metavar='ID_OR_PATH', help='apps 列出的桌面入口')
    parser.add_argument('--display', choices=('auto', 'x11', 'wayland'), default='auto')
    parser.add_argument('--graphics', choices=('auto', 'software'), default='auto')
    parser.add_argument('mode', nargs='?', default='doctor',
                        choices=('doctor', 'apps', 'codex', 'codex-desktop', 'chatgpt'))
    parser.add_argument('arguments', nargs=argparse.REMAINDER)
    options = parser.parse_args(arguments)
    try:
        if options.mode in ('doctor', 'apps'):
            if (options.arguments or options.executable or options.desktop_file or
                    options.display != 'auto' or options.graphics != 'auto'):
                raise ValueError('doctor/apps 不接受应用启动参数。')
            if options.mode == 'doctor':
                return diagnose(options.workspace, options.check_tools)
            if options.check_tools:
                raise ValueError('--check-tools 仅用于 doctor。')
            print(json.dumps(desktop_apps(), ensure_ascii=False, indent=2))
            return 0
        if options.check_tools:
            raise ValueError('--check-tools 仅用于 doctor。')
        workspace = workspace_path(options.workspace)
        args, env = command(options.mode, options.arguments, options.executable,
                            options.desktop_file, options.display, options.graphics)
        if options.desktop_file and options.workspace:
            entry = next(item for item in desktop_apps()
                         if options.desktop_file in (item['id'], item['path']))
            if entry['workingDirectory'] and Path(entry['workingDirectory']).resolve() != workspace:
                raise ValueError('桌面入口的 Path 会覆盖 --workspace；请使用 --executable 启动。')
        env['PWD'] = str(workspace)
        return subprocess.call(args, env=env, cwd=str(workspace))
    except (ValueError, OSError) as error:
        print(f'droiddeck-assistant: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
